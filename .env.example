# Slack local development
SLACK_BOT_TOKEN=replace-with-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=replace-with-your-socket-mode-token
SLACK_FEEDBACK_COMMAND=/logfeedback
SLACK_BOT_DISPLAY_NAME=Product Feedback Bot
SLACK_APP_DISPLAY_NAME=Product Feedback Bot

# Optional Jira integration
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER_EMAIL=feedback-bot@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_LABEL_PREFIX=slack-feedback
JIRA_TEAM_FIELD_ID=customfield_00000

# Optional local account CSV
ACCOUNTS_CSV_PATH=app/src/accounts.csv

# Optional AI helpers
COMPANY_NAME=Acme Corp
DUPLICATE_DETECTION_ENABLED=true
ROUTING_NUDGE_ENABLED=true
ROUTING_CONFIDENCE_THRESHOLD=0.75
BEDROCK_REGION=us-east-1
BEDROCK_TIMEOUT_MS=4000

# Optional modal copy
BUG_REPORT_CHANNEL_ID=C0XXXXXXXXX
